# 本地数据
DATABASE_PATH=data/tracker.db
OUTPUT_DIR=data/proposals
PROJECTS_FILE=config/projects.json
FEISHU_BOTS_FILE=config/feishu-bots.json

# 允许读取的代码仓库根目录，多个目录用冒号分隔。
# 容器内示例项目位于 /app/examples；公司仓库请以只读卷挂载后加入此白名单。
ALLOWED_REPO_ROOTS=.
MAX_FILE_BYTES=524288
MAX_FILES=5000
MAX_EVIDENCE=12

# 可选：由 LiteLLM 统一调用模型。不配置 MODEL_NAME 时使用离线规则生成初稿。
# 模型名使用 provider/model 格式。
# 各供应商的 Key 使用下方专用变量，MODEL_API_KEY 只用于自定义兼容端点。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# auto：普通千问关闭思考以稳定输出 JSON，仅思考模型自动开启。
# 也可显式设置 off 或 on。
MODEL_THINKING=auto
# 单次模型回答上限，范围 512～32768。
MODEL_MAX_OUTPUT_TOKENS=4096
# 空内容或非法 JSON 的自动重试次数，范围 0～4。
MODEL_JSON_RETRIES=2
# 单次技术方案允许的模型调查步数，范围 4～100。
AGENT_MAX_STEPS=40

# 常见模型供应商凭证（只填写实际使用的项）
DASHSCOPE_API_KEY=
# 百炼工作空间专属地址也可使用这个变量名。
BAILIAN_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 语言无关的源码读取始终可用。Serena + 可用语言服务器会为每个 commit
# 生成增强语义索引，后续方案复用，不把缓存写入用户仓库。
SEMANTIC_ENABLED=true
SEMANTIC_DATA_DIR=data/semantic
SEMANTIC_MAX_INDEX_CHARS=250000
SEMANTIC_MAX_SESSIONS=2
# 单个项目最多自动启动多少种语言服务器，范围 1～12。
SEMANTIC_MAX_LANGUAGES=6
# Go 项目的可选语义增强；非 Go 项目无需配置。
GOPLS_PATH=.tools/bin/gopls
# 可选：系统默认 Go 版本低于项目 go.mod 时，指向较新的 go 可执行文件。
GO_BINARY_PATH=

# GitHub：公开仓库可不填 Token；私有仓库推荐注入只有 Contents:read 的
# GitHub App installation token。Webhook secret 必须随机生成并妥善保存。
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_FULL_SYNC_THRESHOLD=100

# 一个机器人管理多个项目；凭证变量名由 config/feishu-bots.json 引用。
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_PROJECT_TRACKER_APP_ID=
FEISHU_PROJECT_TRACKER_APP_SECRET=

# 只有 transport=webhook 的兼容模式才需要每个机器人的 Verification Token。
# FEISHU_PROJECT_TRACKER_VERIFICATION_TOKEN=

# 旧版单机器人兼容配置。使用 FEISHU_BOTS_FILE 时不需要填写。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 例如 https://your-company.feishu.cn
FEISHU_TENANT_DOMAIN=
# 至少配置一种允许范围；多个 ID 用英文逗号分隔。
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_ALLOWED_USER_IDS=
